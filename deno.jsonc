{
  "name": "@fathym/ioc",
  "version": "0.0.0",
  // Consume freshly-published in-house deps without waiting out Deno 2.9's default 24h
  // minimumDependencyAge supply-chain gate. This is needed even where no SOURCE file
  // imports the dep: the universal "version" task runs
  // `deno run -A jsr:@fathym/common@0.2.325/build/version`, and that resolution is what
  // the gate blocks -- so the CI failure lands on `deno task version`, not on a build.
  // Already the house default in 29 sibling repos.
  "minimumDependencyAge": "0",
  "exports": {
    ".": "./mod.ts",
    "./agents": "./src/agents/.exports.ts",
    "./init-agents": "./src/agents/init.ts",
    "./mcp": "./src/mcp/.exports.ts"
  },
  // What JSR publishes: the library and its landing docs (the full docs live on GitHub).
  "publish": {
    "include": ["mod.ts", "src/", "README.md", "LICENSE", "CHANGELOG.md"]
  },
  "tasks": {
    "build": "deno task build:fmt && deno task build:lint && deno task build:check && deno task build:docs && deno task build:mod",
    "build:check": "deno check **/*.ts",
    "build:docs": "deno task docs:check && deno run -A scripts/mcp-data.ts --check",
    "build:mod": "deno run -A mod.ts build",
    "build:fmt": "deno fmt",
    "build:lint": "deno lint",
    "deploy": "deno task build && deno task test && fathym git",
    "test": "deno test -A tests/tests.ts --parallel --coverage=cov",
    "bench": "deno bench -A tests/ioc/resolve.bench.ts",
    "size": "deno run -A scripts/size.ts",
    "coverage": "deno run -A scripts/coverage.ts",
    "compare": "deno run -A compare/run.ts",
    "mcp:data": "deno run -A scripts/mcp-data.ts",
    "build:npm": "deno run -A scripts/build-npm.ts",
    "test:runtimes": "deno run -A scripts/test-runtimes.ts",
    "docs:check": "deno run -A scripts/docs-check.ts",
    "docs:llms": "deno run -A scripts/docs-check.ts --write",
    "version": "deno run -A jsr:@fathym/common@0.2.343/build/version"
  },
  "imports": {},
  // Build output (the npm package) is generated, never checked, linted or formatted. The eval
  // tasks are agents' workspaces (some deliberately broken), each with its own deno.json.
  "exclude": ["dist/", "cov/", "evals/tasks/", "evals/results/"],
  "lint": {
    "include": ["src/", "tests/", "scripts/", "examples/", "compare/"],
    // The MCP knowledge base is generated by `deno task mcp:data`.
    "exclude": ["tests/fixtures/", "src/mcp/data.ts"],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": []
    }
  },
  "fmt": {
    "include": ["src/", "tests/", "scripts/", "examples/", "compare/", "docs/", ".github/", "*.md"],
    "exclude": ["tests/fixtures/", "src/mcp/data.ts"],
    "indentWidth": 2,
    "lineWidth": 100,
    "proseWrap": "preserve",
    "semiColons": true,
    "singleQuote": true,
    "useTabs": false
  },
  // Deno KV types are used by the docs and examples (the pattern dependents use).
  "unstable": ["kv"],
  "compilerOptions": {
    "strict": true
  },
  "lock": false
}
