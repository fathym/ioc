{
  "name": "@fathym/ioc",
  "version": "0.0.0",
  // Consume freshly-published in-house deps without waiting out Deno 2.9's default 24h
  // minimumDependencyAge supply-chain gate. This is needed even where no SOURCE file
  // imports the dep: the universal "version" task runs
  // `deno run -A jsr:@fathym/common@0.2.325/build/version`, and that resolution is what
  // the gate blocks -- so the CI failure lands on `deno task version`, not on a build.
  // Already the house default in 29 sibling repos.
  "minimumDependencyAge": "0",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "build": "deno task build:fmt && deno task build:lint && deno task build:check && deno task build:mod",
    "build:check": "deno check **/*.ts",
    "build:mod": "deno run -A mod.ts build",
    "build:fmt": "deno fmt",
    "build:lint": "deno lint",
    "deploy": "deno task build && deno task test && fathym git",
    "test": "deno test -A tests/tests.ts --parallel --coverage=cov",
    "version": "deno run -A jsr:@fathym/common@0.2.325/build/version"
  },
  "imports": {},
  "lint": {
    "include": ["src/"],
    "exclude": [],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": []
    }
  },
  "fmt": {
    "include": ["src/"],
    "exclude": [],
    "indentWidth": 2,
    "lineWidth": 100,
    "proseWrap": "preserve",
    "semiColons": true,
    "singleQuote": true,
    "useTabs": false
  },
  "unstable": ["kv"],
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.window",
      "deno.unstable"
    ],
    "strict": true
  },
  "lock": false
}
